PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Shared secret so only the Next.js server (not arbitrary clients) can call
# /api/auth/oauth-sync — must match INTERNAL_API_SECRET in frontend/.env.local
INTERNAL_API_SECRET=replace_with_a_long_random_secret

# Nodemailer (SMTP) — used for the signup "verify your email" link,
# password-reset links, and the contact form's admin notification. Leave
# blank (as below) and the app still works fully — those emails just fail
# silently (logged server-side, never blocks the request that triggered
# them) until real SMTP credentials are added. Needs a real domain to send
# from credibly (most SMTP providers require a verified sending domain).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Cloud image storage (utils/cloudinary.ts) — leave all three blank and
# uploads keep working exactly as before: saved to this server's own local
# uploads/ folder and served at /uploads/... . Once all three are set, every
# NEW upload (product/banner/ad images, profile pictures) goes to Cloudinary
# instead and the document stores its returned https URL — no other code
# changes needed, and existing local-path images keep working unchanged.
# Free account at cloudinary.com; these three values are on its dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

# This server's own PUBLIC URL — required for posting ads with an image to
# Facebook/Instagram, since Meta's servers fetch the image from this address
# directly. Must be a real https URL once deployed; localhost only works if
# Meta could somehow reach your machine, which in practice it can't.
SERVER_PUBLIC_URL=http://localhost:5000

# Social media ads (views/AdminAdsView) — leave any of these blank and that
# platform just shows "Not connected" instead of posting; nothing else
# breaks. See src/integrations/meta.ts and src/integrations/x.ts.

# Facebook Page + Instagram (Meta Graph API) — same Page access token covers
# both. Create an app at developers.facebook.com, add your own Facebook/
# Instagram accounts as testers (no App Review needed for that), and
# generate a long-lived Page access token with pages_manage_posts +
# instagram_content_publish.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# X (Twitter) — posting requires a paid API tier as of X's current pricing.
# Create a project/app at developer.twitter.com with Read+Write permissions,
# then generate both the app's consumer keys and an access token/secret for
# the account that should post.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Error monitoring (utils/errorMonitoring.ts) — leave blank and errors still
# print to the console exactly as before; adding a DSN also reports them to
# Sentry (create a free project at sentry.io, "Node" platform, and copy its
# DSN here). No code changes needed either way.
SENTRY_DSN=

# Promotional SMS (views/AdminCampaignsView) — see src/integrations/sms.ts.
# Unlike the integrations above, there's no single standard API across
# Bangladeshi bulk-SMS gateways (BulkSMSBD, MimSMS, SSL Wireless, Alpha SMS,
# etc.), so this targets the single most common shape (an HTTP GET with
# api_key/senderid/number/message query params). Once you've picked a real
# gateway, check its docs — if its field names or method differ, open
# src/integrations/sms.ts and adjust the request there to match; everything
# else (opt-in, campaigns) stays the same either way. Leave blank and SMS
# sends just fail silently, same as SMTP above.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_METHOD=GET
