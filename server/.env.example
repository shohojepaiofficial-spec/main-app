PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Shared secret so only the Next.js server (not arbitrary clients) can call
# /api/auth/oauth-sync — must match INTERNAL_API_SECRET in frontend/.env.local
INTERNAL_API_SECRET=replace_with_a_long_random_secret

# Resend (src/utils/sendEmail.ts) — used for the signup "verify your email"
# link, password-reset links, the welcome email, the contact form's admin
# notification, and marketing campaigns; every email this app sends goes
# through this one place. Leave blank and the app still works fully — those
# emails just fail silently (logged server-side, never blocks the request
# that triggered them) until real credentials are added.
#
# This used to be raw SMTP (nodemailer, direct to a mailbox provider), but
# that turned out to be a hard, consistent connection timeout from Railway
# specifically — regardless of port (465 or 587) — most likely one side
# blocking the other's outbound network path, not something fixable in this
# codebase. Resend sends over its own HTTPS API instead, which doesn't have
# that problem. Free account at resend.com; RESEND_API_KEY is on its
# dashboard. EMAIL_FROM must be an address on a domain verified there (add
# the SPF/DKIM records Resend gives you — if the domain already has an SPF
# TXT record for another mail provider, add Resend's `include:` to that same
# record rather than creating a second one; a domain can only have one SPF
# record). Their sandbox address (onboarding@resend.dev) only delivers to
# your own account email, not real customers, until a domain is verified.
RESEND_API_KEY=
EMAIL_FROM=

# Cloud image storage (utils/cloudinary.ts) — leave all three blank and
# uploads keep working exactly as before: saved to this server's own local
# uploads/ folder and served at /uploads/... . Once all three are set, every
# NEW upload (product/banner/ad images, profile pictures) goes to Cloudinary
# instead and the document stores its returned https URL — no other code
# changes needed, and existing local-path images keep working unchanged.
# Free account at cloudinary.com; these three values are on its dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

# This server's own PUBLIC URL — required for posting ads with an image to
# Facebook/Instagram (Meta's servers fetch the image from this address
# directly) and as the base of bKash's payment callbackURL below (the
# customer's own browser is redirected here after paying, so it must be
# reachable by them, not by bKash's servers specifically — localhost is fine
# for local testing, but needs to be a real https URL once deployed).
SERVER_PUBLIC_URL=http://localhost:5000

# bKash Tokenized Checkout (src/integrations/bkash.ts) — leave any of these
# blank and "bkash" just isn't offered as a payment method at checkout
# (createOrder 400s on it); Cash on Delivery keeps working either way. Get
# real merchant credentials by registering at developer.bka.sh — that portal
# also hands out sandbox (test-money) credentials instantly, before your
# live merchant application is even approved, which is the right thing to
# put here first.
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=

# Pathao Courier (src/integrations/pathao.ts) — leave any of these blank and
# admin orders can still track courier info manually, but the "Book with
# Pathao" button stays disabled. Unlike bKash, Pathao only issues sandbox
# credentials on request (email their merchant integration team), not from a
# public test app — so this hasn't been live-tested yet; treat the first
# real booking as a smoke test and expect to adjust integrations/pathao.ts
# if Pathao's actual response shape differs from what's documented.
# PATHAO_STORE_ID comes from Pathao's Store API/dashboard once you have an
# account, not from the credentials themselves.
PATHAO_BASE_URL=https://courier-api-sandbox.pathao.com
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=

# Social media ads (views/AdminAdsView) — leave any of these blank and that
# platform just shows "Not connected" instead of posting; nothing else
# breaks. See src/integrations/meta.ts and src/integrations/x.ts.

# Facebook Page + Instagram (Meta Graph API) — same Page access token covers
# both. Create an app at developers.facebook.com, add your own Facebook/
# Instagram accounts as testers (no App Review needed for that), and
# generate a long-lived Page access token with pages_manage_posts +
# instagram_content_publish.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# X (Twitter) — posting requires a paid API tier as of X's current pricing.
# Create a project/app at developer.twitter.com with Read+Write permissions,
# then generate both the app's consumer keys and an access token/secret for
# the account that should post.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Error monitoring (utils/errorMonitoring.ts) — leave blank and errors still
# print to the console exactly as before; adding a DSN also reports them to
# Sentry (create a free project at sentry.io, "Node" platform, and copy its
# DSN here). No code changes needed either way.
SENTRY_DSN=

# Promotional SMS (views/AdminCampaignsView) — see src/integrations/sms.ts.
# Unlike the integrations above, there's no single standard API across
# Bangladeshi bulk-SMS gateways (BulkSMSBD, MimSMS, SSL Wireless, Alpha SMS,
# etc.), so this targets the single most common shape (an HTTP GET with
# api_key/senderid/number/message query params). Once you've picked a real
# gateway, check its docs — if its field names or method differ, open
# src/integrations/sms.ts and adjust the request there to match; everything
# else (opt-in, campaigns) stays the same either way. Leave blank and SMS
# sends just fail silently, same as email above.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_METHOD=GET
